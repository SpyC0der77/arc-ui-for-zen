<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows counterpart of text-render.swift. Build:
       dotnet publish demo-video/scripts/text-render-win -c Release -o artifacts/bin/text-render-win -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>text-render</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
  </ItemGroup>
</Project>
