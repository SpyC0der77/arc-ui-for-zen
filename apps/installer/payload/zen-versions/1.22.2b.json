{
  "version": "1.22.2b",
  "notes": "Predates Zen's native library and its Archive. The gift button opens a menu with Downloads, Bookmarks, History and recently closed tabs instead. Idle tabs stay open, debug mode is off, and the sidebar slides with Zen's own older transition.",
  "features": {
    "library": "menu",
    "archive": false,
    "debugMode": false
  },
  "unavailable": {
    "native library": [
      "zen-library",
      "zen-library-button",
      "zen-library-section",
      "zen-library-side",
      "zen-library-footer",
      "zen-library-download-list",
      "zen-library-sprite",
      "zen-library-space",
      "zen-library-space-header",
      "zen-library-space-background",
      "zen-library-row-actions",
      "zen-library-history-section",
      "zen.library.history.closed-tabs"
    ],
    "debug mode fixtures": [
      "zen-library-row",
      "zen-library-row-icon",
      "zen-library-row-text",
      "zen-library-row-title",
      "zen-library-row-subtitle",
      "zen-library-group",
      "zen-library-media-grid",
      "zen-library-media-item",
      "zen-library-media-frame",
      "zen-library-media-thumb",
      "zen-library-empty",
      "zen-library-search-box",
      "moz-src:///zen/library/ZenLibraryUtils.sys.mjs"
    ],
    "compact sidebar transition": ["--zen-compact-hidden-translate"],
    "color editor window": ["zen-keep-opener-active"],
    "scroll-to-selected-tab control": ["zen-workspace-scroll-to-tab-icon"]
  },
  "runtime": {
    "windows-x64": {
      "url": "https://github.com/zen-browser/desktop/releases/download/1.22.2b/zen.installer.exe",
      "sha256": "4f41be779c17aab135083851c90b68379cc7bc498886dbff4dcc3843ff3aa8de"
    }
  }
}
