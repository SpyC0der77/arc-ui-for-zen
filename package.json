{
  "name": "arc-skeleton-zen-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform installer for Arc Skeleton theme and behavior patches for Zen Browser",
  "license": "UNLICENSED",
  "main": "installer/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/engine.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "dev.arc-skeleton.zen-installer",
    "productName": "Arc Skeleton for Zen",
    "directories": { "output": "release" },
    "files": ["installer/**/*.cjs", "installer/ui/**/*", "payload/**/*", "package.json"],
    "win": { "target": ["portable"], "requestedExecutionLevel": "asInvoker", "artifactName": "Arc-Skeleton-Zen-${version}-Windows.${ext}" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.utilities", "artifactName": "Arc-Skeleton-Zen-${version}-macOS-${arch}.${ext}" },
    "linux": { "target": ["AppImage"], "category": "Utility", "artifactName": "Arc-Skeleton-Zen-${version}-Linux-${arch}.${ext}" }
  }
}
